# ==========================================================================
#  Emacs config — .gitignore
#  Tracked: init.el, early-init.el, configs/**, and the straight lockfile.
#  Ignored: every runtime/build/state artifact Emacs or straight generates.
# ==========================================================================

# --- Generic Emacs cruft ---------------------------------------------------
*~
\#*\#
.\#*
*.elc
*.eln
auto-save-list
tramp
/.emacs.desktop
/.emacs.desktop.lock

# --- straight.el -----------------------------------------------------------
# Ignore everything straight builds/clones, but KEEP the version lockfile so
# both machines pin identical package revisions. Note the `/*` — you must
# ignore straight's *contents*, not the dir itself, for the negation to work.
/straight/*
!/straight/versions/

# --- Native-compilation & LSP / tree-sitter caches -------------------------
/eln-cache/
/.cache/
/.lsp-session-v1
/tree-sitter/

# --- Legacy / backup package dirs (pre-straight) ---------------------------
/elpa/
/elpa_backup/
/quelpa/
.cask/
dist/

# --- Transient menu state --------------------------------------------------
/transient/

# --- Persisted session state & histories -----------------------------------
/history
/recentf
/bookmarks
/places
/projects
/ielm-history.eld
/projectile-bookmarks.eld
/projectile-frecency.eld
/eshell/history
/eshell/lastdir

# --- Backups & auto-saves created by init-setup.el -------------------------
/backups/
/auto-saves/

# --- agent-shell / claude scratch ------------------------------------------
/agent/
/.agent-shell/
/.claude-agent-shell/

# --- Org / flymake / flycheck side files -----------------------------------
.org-id-locations
*_archive
*_flymake.*
flycheck_*.el

# --- Server auth & network security ----------------------------------------
/server/
/network-security.data

# --- Customize output (machine-local; regenerated by the file-exists-p ------
#     guard in init-setup.el, so a fresh clone works without it) -------------
/custom.el

# --- Project-local overrides -----------------------------------------------
.dir-locals.el
.projectile

# --- OS / editor noise -----------------------------------------------------
.DS_Store
# Vim swap/undo (in case these files get edited from vim too)
[._]*.s[a-v][a-z]
!*.svg
[._]*.sw[a-p]
[._]*.un~
Session.vim
Sessionx.vim
.netrwhist
tags
